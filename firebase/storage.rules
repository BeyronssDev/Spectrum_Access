rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasClaim(claim) {
      return signedIn() && request.auth.token.get(claim, false) == true;
    }

    function isModerator() {
      return hasClaim("superAdmin") || hasClaim("moderator") || hasClaim("admin");
    }

    function validImage() {
      return request.resource != null
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
    }

    function isVerifiedProfessionalProfile(uid, profileId) {
      return firestore.exists(/databases/(default)/documents/professionalProfiles/$(profileId))
        && firestore.get(/databases/(default)/documents/professionalProfiles/$(profileId)).data.ownerUid == uid
        && firestore.get(/databases/(default)/documents/professionalProfiles/$(profileId)).data.verificationStatus == "verified";
    }

    function isVerifiedOrganizationProfile(uid, profileId) {
      return firestore.exists(/databases/(default)/documents/organizationProfiles/$(profileId))
        && firestore.get(/databases/(default)/documents/organizationProfiles/$(profileId)).data.ownerUid == uid
        && firestore.get(/databases/(default)/documents/organizationProfiles/$(profileId)).data.verificationStatus == "verified";
    }

    match /place-images/{uid}/{imageId}/{fileName} {
      allow read: if isModerator()
        || firestore.exists(/databases/(default)/documents/placeImages/$(imageId))
        && firestore.get(/databases/(default)/documents/placeImages/$(imageId)).data.status == "active";
      allow write: if isOwner(uid) && validImage();
      allow delete: if isModerator();
    }

    match /event-experience-images/{uid}/{experienceId}/{fileName} {
      allow read: if isModerator()
        || firestore.exists(/databases/(default)/documents/eventExperiences/$(experienceId))
        && firestore.get(/databases/(default)/documents/eventExperiences/$(experienceId)).data.status == "active";
      allow write: if isOwner(uid) && validImage();
      allow delete: if isModerator();
    }

    match /profile-photos/{uid}/{fileName} {
      allow read: if isOwner(uid) || isModerator();
      allow write: if isOwner(uid) && validImage();
      allow delete: if isOwner(uid) || isModerator();
    }

    match /professional-photos/{uid}/{profileId}/{fileName} {
      allow read: if isOwner(uid) || isModerator() || isVerifiedProfessionalProfile(uid, profileId);
      allow write: if isOwner(uid) && validImage();
      allow delete: if isOwner(uid) || isModerator();
    }

    match /professional-photos/{uid}/{fileName} {
      allow read: if isOwner(uid) || isModerator();
      allow write: if isOwner(uid) && validImage();
      allow delete: if isOwner(uid) || isModerator();
    }

    match /organization-logos/{uid}/{profileId}/{fileName} {
      allow read: if isOwner(uid) || isModerator() || isVerifiedOrganizationProfile(uid, profileId);
      allow write: if isOwner(uid) && validImage();
      allow delete: if isOwner(uid) || isModerator();
    }

    match /organization-logos/{uid}/{fileName} {
      allow read: if isOwner(uid) || isModerator();
      allow write: if isOwner(uid) && validImage();
      allow delete: if isOwner(uid) || isModerator();
    }

    match /verification-evidence/{uid}/{fileName} {
      allow read: if isOwner(uid) || isModerator();
      allow write: if isOwner(uid) && request.resource != null && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isOwner(uid) || isModerator();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
